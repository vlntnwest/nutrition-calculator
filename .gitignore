# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# sauf le gabarit et les deux fichiers qui pointent le Postgres local : aucun ne
# porte de secret — l'exception doit suivre la règle qu'elle annule, git applique
# le dernier motif qui correspond
!.env.example
!.env
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Captures et comps de la revue de design : des artefacts, pas des sources.
.impeccable/review/
.impeccable/mocks/

# Profil Chrome du skill impeccable : cookies et identifiants réels, jamais un artefact à commiter.
.impeccable/chrome-profile/
