{
  "name": "nutrition-calculator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "analyze": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/analyze.mts",
    "strip-gpx": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/strip-gpx.mts",
    "plan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/plan.mts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simplify-js": "^1.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fast-check": "^4.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
